# =============================================================================
# AI-Powered Resume Analysis — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows)
# =============================================================================

# Google Gemini API Key (required)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Gemini Model Name (optional — defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Database path (optional — defaults to data/database.db)
DATABASE_PATH=data/database.db

# Resume upload directory (optional — defaults to data/resumes)
RESUME_UPLOAD_DIR=data/resumes

# Logging level (optional — DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
